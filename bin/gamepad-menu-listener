#!/usr/bin/env python3
import glob
import json
import os
import select
import struct
import subprocess
import time

GAMEPAD = "/dev/input/by-id/usb-Zikway_HID_gamepad-joystick"
GAMEPAD_EVENT = "/dev/input/by-id/usb-Zikway_HID_gamepad-event-joystick"
FALLBACK = "/dev/input/js0"
MENU = os.path.join(os.path.dirname(os.path.abspath(__file__)), "game-menu")
LOG = "/tmp/gamepad-menu-listener.log"
CONFIG_PATH = os.path.expanduser("~/.config/gamepad-menu/settings.json")
HOME_BUTTON = 12
A_BUTTON = 0
DPAD_Y = 7
LEFT_STICK_Y = 1
EV_KEY = 1
EV_ABS = 3
ABS_Y = 1
ABS_HAT0Y = 17
BTN_SOUTH = 304
BTN_MODE = 316
KEY_HOMEPAGE = 172
ANALOG_CENTER = 128
ANALOG_DEADZONE = 48
DEBOUNCE_SECONDS = 0.7
TV_ACTION_DEBOUNCE_SECONDS = 0.22


def log(message):
    with open(LOG, "a", encoding="utf-8") as log_file:
        print(f"{time.strftime('%F %T')} {message}", file=log_file, flush=True)


def unique(paths):
    seen = set()
    unique_paths = []
    for path in paths:
        if path in seen:
            continue
        seen.add(path)
        unique_paths.append(path)
    return unique_paths


def input_paths():
    event_paths = unique(
        [GAMEPAD_EVENT]
        + sorted(glob.glob("/dev/input/by-id/*event-joystick"))
        + sorted(glob.glob("/dev/input/by-id/*event-if*"))
        + sorted(glob.glob("/dev/input/by-id/*event-kbd"))
    )
    joystick_paths = unique([GAMEPAD, FALLBACK] + sorted(glob.glob("/dev/input/by-id/*-joystick")))
    return event_paths, joystick_paths


def open_inputs():
    opened = []
    event_paths, joystick_paths = input_paths()

    for path in event_paths:
        try:
            opened.append({"file": open(path, "rb", buffering=0), "kind": "event", "path": path})
            log(f"opening {path}")
        except (FileNotFoundError, PermissionError, OSError) as exc:
            log(f"cannot open {path}: {exc}")

    if not opened:
        for path in joystick_paths:
            try:
                opened.append({"file": open(path, "rb", buffering=0), "kind": "js", "path": path})
                log(f"opening {path}")
                break
            except (FileNotFoundError, PermissionError, OSError) as exc:
                log(f"cannot open {path}: {exc}")

    if not opened:
        raise FileNotFoundError("no gamepad input device found")

    return opened


def close_inputs(inputs):
    for item in inputs:
        try:
            item["file"].close()
        except OSError:
            pass


def auto_pause_enabled():
    return setting_enabled("auto_pause_on_open")


def auto_space_enabled():
    return setting_enabled("auto_space_on_open")


def tv_mode_enabled():
    return setting_enabled("tv_mode_enabled")


def tv_mode_send_space_enabled():
    return setting_enabled("tv_mode_send_space")


def setting_enabled(name):
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as settings_file:
            settings = json.load(settings_file)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return False
    return settings.get(name) is True


def send_key(command, label):
    try:
        result = subprocess.run(
            command,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            timeout=1,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        log(f"auto {label} failed: {exc}")
        return False

    if result.returncode != 0:
        error = result.stderr.strip() or f"exit status {result.returncode}"
        log(f"auto {label} failed: {error}")
        return False

    log(f"auto {label} sent")
    return True


def auto_pause():
    if not auto_pause_enabled():
        return
    send_key(["wtype", "-k", "Escape"], "pause")


def auto_space():
    if not auto_space_enabled():
        return
    if send_key(["hyprctl", "dispatch", "sendshortcut", ", space, activewindow"], "space"):
        return
    send_key(["wtype", " "], "space fallback")


def pactl_sinks():
    try:
        output = subprocess.check_output(
            ["pactl", "list", "short", "sinks"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=1,
        )
    except Exception:
        return []

    sinks = []
    for line in output.splitlines():
        fields = line.split("\t")
        if len(fields) < 5:
            continue
        sinks.append({"id": fields[0], "name": fields[1], "state": fields[4]})
    return sinks


def default_sink_name():
    try:
        return subprocess.check_output(
            ["pactl", "get-default-sink"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=1,
        ).strip()
    except Exception:
        return ""


def audio_sink_target():
    sinks = pactl_sinks()
    default_name = default_sink_name()
    for sink in sinks:
        if sink["name"] == default_name and sink["state"] == "RUNNING":
            return sink["name"]
    for sink in sinks:
        if sink["state"] == "RUNNING":
            return sink["name"]
    return "@DEFAULT_SINK@"


def tv_volume(direction):
    target = audio_sink_target()
    if direction > 0:
        command = ["pactl", "set-sink-volume", target, "+5%"]
        label = "volume up"
    else:
        command = ["pactl", "set-sink-volume", target, "-5%"]
        label = "volume down"
    send_key(command, label)


def tv_space():
    send_key(["wtype", " "], "tv space")


last_press = 0.0
last_tv_actions = {}
last_js_dpad_y = 0
pressed_event_buttons = set()
pressed_js_buttons = set()


def open_menu_from_home(source):
    global last_press
    now = time.monotonic()
    if now - last_press < DEBOUNCE_SECONDS:
        return

    last_press = now
    log(f"home button pressed: {source}")
    if auto_space_enabled():
        auto_space()
    else:
        auto_pause()
    subprocess.Popen([MENU])


def tv_action(action, source):
    if not tv_mode_enabled():
        return False

    now = time.monotonic()
    if now - last_tv_actions.get(action, 0.0) < TV_ACTION_DEBOUNCE_SECONDS:
        return True

    last_tv_actions[action] = now
    log(f"tv mode {action}: {source}")
    if action == "volume_up":
        tv_volume(1)
    elif action == "volume_down":
        tv_volume(-1)
    elif action == "space":
        tv_space()
    return True


while True:
    inputs = []
    try:
        inputs = open_inputs()
        files = [item["file"] for item in inputs]
        by_file = {item["file"]: item for item in inputs}

        while True:
            ready, _, _ = select.select(files, [], [], 1)
            if not ready:
                continue

            for gamepad in ready:
                item = by_file[gamepad]
                if item["kind"] == "event":
                    data = gamepad.read(24)
                    if len(data) != 24:
                        raise OSError(f"{item['path']} disconnected")

                    _, _, event_type, code, value = struct.unpack("llHHi", data)
                    source = f"path={item['path']} type={event_type} code={code} value={value}"
                    if event_type == EV_KEY:
                        button = (item["path"], code)
                        if value == 1 and button not in pressed_event_buttons:
                            pressed_event_buttons.add(button)
                            if code in (BTN_MODE, KEY_HOMEPAGE):
                                open_menu_from_home(source)
                            elif code == BTN_SOUTH and tv_mode_send_space_enabled():
                                tv_action("space", source)
                        elif value == 0 and button in pressed_event_buttons:
                            pressed_event_buttons.discard(button)
                    elif event_type == EV_ABS:
                        if code == ABS_HAT0Y:
                            if value == -1:
                                tv_action("volume_up", source)
                            elif value == 1:
                                tv_action("volume_down", source)
                        elif code == ABS_Y:
                            if value < ANALOG_CENTER - ANALOG_DEADZONE:
                                tv_action("volume_up", source)
                            elif value > ANALOG_CENTER + ANALOG_DEADZONE:
                                tv_action("volume_down", source)
                else:
                    data = gamepad.read(8)
                    if len(data) != 8:
                        raise OSError(f"{item['path']} disconnected")

                    _, value, event_type, number = struct.unpack("IhBB", data)
                    if event_type & 0x80:
                        continue

                    is_button = event_type & 0x01
                    source = f"path={item['path']} type={event_type} number={number} value={value}"
                    if is_button:
                        button = (item["path"], number)
                        if value == 1 and button not in pressed_js_buttons:
                            pressed_js_buttons.add(button)
                            if number == HOME_BUTTON:
                                open_menu_from_home(source)
                            elif number == A_BUTTON and tv_mode_send_space_enabled():
                                tv_action("space", source)
                        elif value == 0 and button in pressed_js_buttons:
                            pressed_js_buttons.discard(button)
                    elif not is_button and number in (DPAD_Y, LEFT_STICK_Y):
                        if number == DPAD_Y:
                            if value != last_js_dpad_y:
                                last_js_dpad_y = value
                                if value == -32767:
                                    tv_action("volume_up", source)
                                elif value == 32767:
                                    tv_action("volume_down", source)
                        elif value < -16000:
                            tv_action("volume_up", source)
                        elif value > 16000:
                            tv_action("volume_down", source)
    except FileNotFoundError:
        log("gamepad not found")
        time.sleep(2)
    except PermissionError:
        log("permission denied")
        time.sleep(2)
    except Exception as exc:
        log(f"error: {exc}")
        time.sleep(2)
    finally:
        close_inputs(inputs)
