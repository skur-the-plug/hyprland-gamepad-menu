    {"key": "screenshot_area", "label": "Screenshot area", "command": 'grim -g "$(slurp)" - | wl-copy', "close_after": True},
    {"key": "system_monitor", "label": "System monitor", "command": ["plasma-systemmonitor"], "close_after": True},
