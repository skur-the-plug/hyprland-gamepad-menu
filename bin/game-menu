def notify(message):
    if shutil_which("notify-send"):
        subprocess.Popen(["notify-send", "Game menu", message])


def shutil_which(name):
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        path = os.path.join(directory, name)
        if os.path.exists(path) and os.access(path, os.X_OK):
            return path
    return None


def default_settings():
    settings = {
        "auto_pause_on_open": DEFAULT_SETTINGS["auto_pause_on_open"],
        "auto_space_on_open": DEFAULT_SETTINGS["auto_space_on_open"],
        "tv_mode_enabled": DEFAULT_SETTINGS["tv_mode_enabled"],
        "tv_mode_send_space": DEFAULT_SETTINGS["tv_mode_send_space"],
        "show_actions": {},
    }
    for action in ACTIONS:
        settings["show_actions"][action["key"]] = True
    return settings


def load_settings():
    settings = default_settings()
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as settings_file:
            loaded = json.load(settings_file)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return settings

    if isinstance(loaded.get("auto_pause_on_open"), bool):
        settings["auto_pause_on_open"] = loaded["auto_pause_on_open"]
    if isinstance(loaded.get("auto_space_on_open"), bool):
        settings["auto_space_on_open"] = loaded["auto_space_on_open"]
    if isinstance(loaded.get("tv_mode_enabled"), bool):
        settings["tv_mode_enabled"] = loaded["tv_mode_enabled"]
    if isinstance(loaded.get("tv_mode_send_space"), bool):
        settings["tv_mode_send_space"] = loaded["tv_mode_send_space"]
    if isinstance(loaded.get("show_actions"), dict):
        for action in ACTIONS:
            value = loaded["show_actions"].get(action["key"])
            if isinstance(value, bool):
                settings["show_actions"][action["key"]] = value
    return settings


def save_settings(settings):
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    with open(CONFIG_PATH, "w", encoding="utf-8") as settings_file:
        json.dump(settings, settings_file, indent=2, sort_keys=True)
        settings_file.write("\n")


def load_playlists():
    try:
        with open(PLAYLISTS_PATH, "r", encoding="utf-8") as playlists_file:
            playlists = json.load(playlists_file)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return []

    if not isinstance(playlists, list):
        return []

    valid_playlists = []
    for playlist in playlists:
        if not isinstance(playlist, dict):
            continue
        name = str(playlist.get("name", "")).strip()
        uri = str(playlist.get("uri", "")).strip()
        cover_url = str(playlist.get("cover_url", "")).strip()
        if name and uri:
            valid_playlists.append({"name": name, "uri": uri, "cover_url": cover_url})
    return valid_playlists


def open_gamepad():
    path = GAMEPAD if os.path.exists(GAMEPAD) else FALLBACK
    return open(path, "rb", buffering=0)


def current_track():
    try:
        output = subprocess.check_output(
            [
                "playerctl",
                "-p",
                "spotify",
                "metadata",
                "--format",
                "{{artist}}\n{{title}}\n{{mpris:artUrl}}\n{{mpris:length}}",
            ],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=1,
        )
    except Exception:
        return None

    lines = output.rstrip("\n").split("\n")
    while len(lines) < 4:
        lines.append("")

    artist, title, art_url, length = lines[:4]
    try:
        length_seconds = max(0.0, int(length) / 1_000_000)
    except ValueError:
        length_seconds = 0.0
    try:
        position = max(
            0.0,
            float(
                subprocess.check_output(
                    ["playerctl", "-p", "spotify", "position"],
                    text=True,
                    stderr=subprocess.DEVNULL,
                    timeout=1,
                ).strip()
            ),
        )
    except Exception:
        position = 0.0

    if not artist and not title and not art_url:
        return None
    return {
        "artist": artist,
        "title": title,
        "art_url": art_url,
        "length": length_seconds,
        "position": position,
    }


def volume_is_muted():
    target = audio_sink_target()
    try:
        output = subprocess.check_output(
            ["pactl", "get-sink-mute", target],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=1,
        )
    except Exception:
        return False
    return "yes" in output.lower()


def pactl_sinks():
    try:
        output = subprocess.check_output(
            ["pactl", "list", "short", "sinks"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=1,
        )
    except Exception:
        return []

    sinks = []
    for line in output.splitlines():
        fields = line.split("\t")
        if len(fields) < 5:
            continue
        sinks.append({"id": fields[0], "name": fields[1], "state": fields[4]})
    return sinks


def default_sink_name():
    try:
        return subprocess.check_output(
            ["pactl", "get-default-sink"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=1,
        ).strip()
    except Exception:
        return ""


def audio_sink_target():
    sinks = pactl_sinks()
    default_name = default_sink_name()
    for sink in sinks:
        if sink["name"] == default_name and sink["state"] == "RUNNING":
            return sink["name"]
    for sink in sinks:
        if sink["state"] == "RUNNING":
            return sink["name"]
    return "@DEFAULT_SINK@"


def run_volume_action(action_key):
    target = audio_sink_target()
    if action_key == "volume_up":
        subprocess.Popen(["pactl", "set-sink-volume", target, "+5%"])
    elif action_key == "volume_down":
        subprocess.Popen(["pactl", "set-sink-volume", target, "-5%"])
    elif action_key == "mute_volume":
        subprocess.Popen(["pactl", "set-sink-mute", target, "toggle"])


def playerctl_value(command, fallback):
    try:
        return subprocess.check_output(
            ["playerctl", "-p", "spotify", command],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=1,
        ).strip()
    except Exception:
        return fallback


def shuffle_state():
    return playerctl_value("shuffle", "Off")


def loop_state():
    return playerctl_value("loop", "None")


def play_status():
    return playerctl_value("status", "Stopped")


def cached_art_path(art_url):
    if not art_url:
        return None

    parsed = urllib.parse.urlparse(art_url)
    if parsed.scheme == "file":
        return urllib.request.url2pathname(parsed.path)

    if parsed.scheme not in ("http", "https"):
        return None

    os.makedirs(ART_CACHE_DIR, exist_ok=True)
    digest = hashlib.sha256(art_url.encode("utf-8")).hexdigest()
    path = os.path.join(ART_CACHE_DIR, f"{digest}.jpg")
    if os.path.exists(path):
        return path

    try:
        with urllib.request.urlopen(art_url, timeout=2) as response:
            image = response.read(2_000_000)
        with open(path, "wb") as image_file:
            image_file.write(image)
        return path
    except Exception:
        return None


def format_time(seconds):
    seconds = max(0, int(seconds))
    minutes, seconds = divmod(seconds, 60)
    return f"{minutes}:{seconds:02d}"


def grab_gamepad():
    try:
        gamepad_event = open(GAMEPAD_EVENT, "rb", buffering=0)
        fcntl.ioctl(gamepad_event, EVIOCGRAB, 1)
        return gamepad_event
    except (FileNotFoundError, PermissionError, OSError):
        return None


def release_gamepad(gamepad_event):
    if gamepad_event is None:
        return
    try:
        fcntl.ioctl(gamepad_event, EVIOCGRAB, 0)
    except OSError:
        pass
    gamepad_event.close()


class GameMenu(Gtk.Window):
    def __init__(self, grabbed_gamepad=None):
        super().__init__(title="Game Menu")
        self.set_default_size(420, 520)
        self.set_resizable(False)
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_position(Gtk.WindowPosition.CENTER)
        try:
            self.set_wmclass("game-menu", "game-menu")
        except Exception:
            pass

        self.selected = 0
        self.selected_area = "music"
        self.music_selected = 2
        self.view = "main"
        self.items = []
        self.settings = load_settings()
        self.playlists = []
        self.playlist_page = 0
        self.last_move = 0.0
        self.gamepad = None
        self.gamepad_event = grabbed_gamepad
        self.rows = []
        self.art = Gtk.Image()
        self.track_title = Gtk.Label(xalign=0)
        self.track_artist = Gtk.Label(xalign=0)
        self.elapsed_label = Gtk.Label(xalign=0)
        self.remaining_label = Gtk.Label(xalign=1)
        self.progress = Gtk.ProgressBar()
        self.music_rows = []

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_margin_top(18)
        box.set_margin_bottom(18)
        box.set_margin_start(18)
        box.set_margin_end(18)
        self.add(box)

        title = Gtk.Label(label="Game Menu", xalign=0)
        title.set_name("title")
        box.pack_start(title, False, False, 0)

        now_playing = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        now_playing.set_name("now-playing")
        box.pack_start(now_playing, False, False, 0)

        self.art.set_size_request(ART_SIZE, ART_SIZE)
        self.art.set_name("music-cover")
        now_playing.pack_start(self.art, False, False, 0)

        track_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        track_box.set_valign(Gtk.Align.CENTER)
        now_playing.pack_start(track_box, True, True, 0)

        self.track_title.set_name("track-title")
        self.track_title.set_ellipsize(Pango.EllipsizeMode.END)
        self.track_artist.set_name("track-artist")
        self.track_artist.set_ellipsize(Pango.EllipsizeMode.END)
        track_box.pack_start(self.track_title, False, False, 0)
        track_box.pack_start(self.track_artist, False, False, 0)

        progress_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        progress_box.set_margin_top(8)
        track_box.pack_start(progress_box, False, False, 0)
        progress_box.pack_start(self.progress, False, False, 0)

        time_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        progress_box.pack_start(time_box, False, False, 0)
        self.elapsed_label.set_name("track-time")
        self.remaining_label.set_name("track-time")
        time_box.pack_start(self.elapsed_label, False, False, 0)
        time_box.pack_end(self.remaining_label, False, False, 0)

        controls_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        controls_box.set_halign(Gtk.Align.CENTER)
        controls_box.set_margin_top(8)
        track_box.pack_start(controls_box, False, False, 0)

        for control in MUSIC_CONTROLS:
            control_label = Gtk.Label(label=control["icon"])
            control_label.get_style_context().add_class("music-control")
            control_label.set_size_request(MUSIC_CONTROL_SIZE, -1)
            controls_box.pack_start(control_label, False, False, 0)
            self.music_rows.append(control_label)

        hint = Gtk.Label(label="D-pad/left stick: move    A: select    B/Home: close", xalign=0)
        hint.set_name("hint")
        box.pack_start(hint, False, False, 0)

        self.menu_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.pack_start(self.menu_box, False, False, 0)
        self.rebuild_rows()

        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.on_key_press)
        self.update_now_playing()
        self.show_all()

        self.try_open_gamepad()
        GLib.timeout_add(25, self.poll_gamepad)
        GLib.timeout_add(1000, self.update_now_playing_timer)

    def try_open_gamepad(self):
        if self.gamepad_event is not None:
            return
        if self.gamepad is not None:
            return
        try:
            self.gamepad = open_gamepad()
        except (FileNotFoundError, PermissionError):
            self.gamepad = None

    def main_items(self):
        items = []
        items.append({"type": "playlists"})
        for action in ACTIONS:
            if self.settings["show_actions"].get(action["key"], True):
                items.append({"type": "action", "action": action})
        items.append({"type": "settings"})
        return items

    def playlist_items(self):
        if not self.playlists:
            self.playlists = load_playlists()

        total = len(self.playlists)
        start = self.playlist_page * PLAYLISTS_PER_PAGE
        if start >= total:
            self.playlist_page = 0
            start = 0
        end = min(start + PLAYLISTS_PER_PAGE, total)

        items = []
        if self.playlist_page > 0:
            items.append({"type": "playlist_prev_page"})
        for playlist in self.playlists[start:end]:
            items.append({"type": "playlist", "playlist": playlist})
        if end < total:
            items.append({"type": "playlist_next_page"})
        if not items:
            items.append({"type": "empty", "label": "No playlists configured"})
        items.append({"type": "back"})
        return items

    def play_mode_items(self):
        return [
            {"type": "shuffle_toggle"},
            {"type": "repeat_none"},
            {"type": "repeat_track"},
            {"type": "repeat_playlist"},
            {"type": "back"},
        ]

    def settings_items(self):
        items = [
            {"type": "toggle_tv_mode"},
            {"type": "toggle_tv_mode_send_space"},
            {"type": "toggle_auto_pause"},
            {"type": "toggle_auto_space"},
        ]
        for action in ACTIONS:
            items.append({"type": "toggle_action", "action": action})
        items.append({"type": "back"})
        return items

    def item_label(self, item):
        item_type = item["type"]
        if item_type == "action":
            if item["action"]["key"] == "mute_volume" and volume_is_muted():
                return "Unmute volume"
            return item["action"]["label"]
        if item_type == "playlists":
            return "Spotify playlists"
        if item_type == "play_modes":
            return "Play modes"
        if item_type == "playlist":
            return item["playlist"]["name"]
        if item_type == "playlist_next_page":
            total_pages = max(1, (len(self.playlists) + PLAYLISTS_PER_PAGE - 1) // PLAYLISTS_PER_PAGE)
            return f"Next page ({self.playlist_page + 2}/{total_pages})"
        if item_type == "playlist_prev_page":
            total_pages = max(1, (len(self.playlists) + PLAYLISTS_PER_PAGE - 1) // PLAYLISTS_PER_PAGE)
            return f"Previous page ({self.playlist_page}/{total_pages})"
        if item_type == "empty":
            return item["label"]
        if item_type == "shuffle_toggle":
            return f"Shuffle: {shuffle_state()}"
        if item_type == "repeat_none":
            prefix = ">" if loop_state() == "None" else " "
            return f"{prefix} Repeat off"
        if item_type == "repeat_track":
            prefix = ">" if loop_state() == "Track" else " "
            return f"{prefix} Repeat track"
        if item_type == "repeat_playlist":
            prefix = ">" if loop_state() == "Playlist" else " "
            return f"{prefix} Repeat playlist"
        if item_type == "settings":
            return "Settings"
        if item_type == "toggle_tv_mode":
            state = "On" if self.settings["tv_mode_enabled"] else "Off"
            return f"TV mode: {state}"
        if item_type == "toggle_tv_mode_send_space":
            state = "On" if self.settings["tv_mode_send_space"] else "Off"
            return f"TV mode A/X sends Space: {state}"
        if item_type == "toggle_auto_pause":
            state = "On" if self.settings["auto_pause_on_open"] else "Off"
            return f"Auto pause on open: {state}"
        if item_type == "toggle_auto_space":
            state = "On" if self.settings["auto_space_on_open"] else "Off"
            return f"Auto space on open: {state}"
        if item_type == "toggle_action":
            action = item["action"]
            state = "On" if self.settings["show_actions"].get(action["key"], True) else "Off"
            return f"Show {action['label']}: {state}"
        if item_type == "back":
            return "Back"
        return ""

    def rebuild_rows(self):
        for child in self.menu_box.get_children():
            self.menu_box.remove(child)

        if self.view == "settings":
            self.items = self.settings_items()
        elif self.view == "playlists":
            self.items = self.playlist_items()
        elif self.view == "play_modes":
            self.items = self.play_mode_items()
        else:
            self.items = self.main_items()
        if self.selected >= len(self.items):
            self.selected = max(0, len(self.items) - 1)

        self.rows = []
        for item in self.items:
            row = self.build_row(item)
            self.menu_box.pack_start(row, False, False, 0)
            self.rows.append(row)

        self.menu_box.show_all()
        self.refresh()

    def refresh(self):
        for index, row in enumerate(self.music_rows):
            context = row.get_style_context()
            row.set_text(self.music_control_label(MUSIC_CONTROLS[index]))
            if self.selected_area == "music" and index == self.music_selected:
                context.add_class("music-selected")
            else:
                context.remove_class("music-selected")

        for index, row in enumerate(self.rows):
            label = getattr(row, "menu_label", None)
            if label is not None:
                label.set_text(self.item_label(self.items[index]))
            context = row.get_style_context()
            if self.selected_area == "menu" and index == self.selected:
                context.add_class("selected")
            else:
                context.remove_class("selected")

    def music_control_label(self, control):
        if control["key"] == "play_pause":
            return "⏸" if play_status() == "Playing" else "▶"
        if control["key"] == "shuffle":
            return "⇄•" if shuffle_state() == "On" else "⇄"
        if control["key"] == "repeat":
            state = loop_state()
            if state == "Track":
                return "↻1"
            if state == "Playlist":
                return "↻•"
            return "↻"
        return control["icon"]

    def build_row(self, item):
        if item["type"] == "playlist":
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            row.get_style_context().add_class("menu-row")
            image = Gtk.Image()
            image.set_size_request(PLAYLIST_ART_SIZE, PLAYLIST_ART_SIZE)
            image.get_style_context().add_class("playlist-cover")
            playlist = item["playlist"]
            art_path = cached_art_path(playlist.get("cover_url", ""))
            if art_path:
                try:
                    pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                        art_path, PLAYLIST_ART_SIZE, PLAYLIST_ART_SIZE, True
                    )
                    image.set_from_pixbuf(pixbuf)
                except Exception:
                    image.clear()
            row.pack_start(image, False, False, 0)
            label = Gtk.Label(label=self.item_label(item), xalign=0)
            label.set_ellipsize(Pango.EllipsizeMode.END)
            row.pack_start(label, True, True, 0)
            row.menu_label = label
            return row

        row = Gtk.Label(label=self.item_label(item), xalign=0)
        row.get_style_context().add_class("menu-row")
        row.menu_label = row
        return row

    def move(self, delta):
        now = time.monotonic()
        if now - self.last_move < MOVE_DEBOUNCE:
            return
        self.last_move = now
        if delta > 0 and self.selected_area == "music":
            self.selected_area = "menu"
            self.selected = 0
        elif delta < 0 and self.selected_area == "menu" and self.selected == 0:
            self.selected_area = "music"
        elif self.selected_area == "menu" and self.items:
            self.selected = (self.selected + delta) % len(self.items)
        self.refresh()

    def move_horizontal(self, delta):
        now = time.monotonic()
        if now - self.last_move < MOVE_DEBOUNCE:
            return
        self.last_move = now
        if self.selected_area == "music":
            self.music_selected = (self.music_selected + delta) % len(MUSIC_CONTROLS)
            self.refresh()

    def activate(self):
        if self.selected_area == "music":
            self.activate_music_control()
            return

        if not self.items:
            return

        item = self.items[self.selected]
        item_type = item["type"]
        if item_type == "playlists":
            self.view = "playlists"
            self.selected = 0
            self.playlist_page = 0
            self.playlists = load_playlists()
            self.rebuild_rows()
            return
        if item_type == "play_modes":
            self.view = "play_modes"
            self.selected = 0
            self.rebuild_rows()
            return
        if item_type == "playlist":
            subprocess.Popen(["playerctl", "-p", "spotify", "open", item["playlist"]["uri"]])
            Gtk.main_quit()
            return
        if item_type == "playlist_next_page":
            self.playlist_page += 1
            self.selected = 0
            self.rebuild_rows()
            return
        if item_type == "playlist_prev_page":
            self.playlist_page = max(0, self.playlist_page - 1)
            self.selected = 0
            self.rebuild_rows()
            return
        if item_type == "empty":
            return
        if item_type == "shuffle_toggle":
            subprocess.Popen(["playerctl", "-p", "spotify", "shuffle", "Toggle"])
            GLib.timeout_add(200, self.refresh_once)
            return
        if item_type == "repeat_none":
            subprocess.Popen(["playerctl", "-p", "spotify", "loop", "None"])
            GLib.timeout_add(200, self.refresh_once)
            return
        if item_type == "repeat_track":
            subprocess.Popen(["playerctl", "-p", "spotify", "loop", "Track"])
            GLib.timeout_add(200, self.refresh_once)
            return
        if item_type == "repeat_playlist":
            subprocess.Popen(["playerctl", "-p", "spotify", "loop", "Playlist"])
            GLib.timeout_add(200, self.refresh_once)
            return
        if item_type == "settings":
            self.view = "settings"
            self.selected = 0
            self.rebuild_rows()
            return
        if item_type == "toggle_tv_mode":
            self.settings["tv_mode_enabled"] = not self.settings["tv_mode_enabled"]
            save_settings(self.settings)
            self.refresh()
            return
        if item_type == "toggle_tv_mode_send_space":
            self.settings["tv_mode_send_space"] = not self.settings["tv_mode_send_space"]
            save_settings(self.settings)
            self.refresh()
            return
        if item_type == "toggle_auto_pause":
            enabled = not self.settings["auto_pause_on_open"]
            self.settings["auto_pause_on_open"] = enabled
            if enabled:
                self.settings["auto_space_on_open"] = False
            save_settings(self.settings)
            self.refresh()
            return
        if item_type == "toggle_auto_space":
            enabled = not self.settings["auto_space_on_open"]
            self.settings["auto_space_on_open"] = enabled
            if enabled:
                self.settings["auto_pause_on_open"] = False
            save_settings(self.settings)
            self.refresh()
            return
        if item_type == "toggle_action":
            action = item["action"]
            current = self.settings["show_actions"].get(action["key"], True)
            self.settings["show_actions"][action["key"]] = not current
            save_settings(self.settings)
            self.refresh()
            return
        if item_type == "back":
            self.view = "main"
            self.selected = 0
            self.rebuild_rows()
            return

        action = item["action"]
        if action["key"] in ("volume_up", "volume_down", "mute_volume"):
            try:
                run_volume_action(action["key"])
            except Exception as exc:
                notify(str(exc))
            GLib.timeout_add(400, self.update_now_playing_once)
            GLib.timeout_add(120, self.refresh_once)
            return

        command = action["command"]
        close_after = action["close_after"]
        try:
            if isinstance(command, str):
                subprocess.Popen(command, shell=True)
            else:
                subprocess.Popen(command)
        except Exception as exc:
            notify(str(exc))
        if close_after:
            Gtk.main_quit()
        else:
            GLib.timeout_add(400, self.update_now_playing_once)
            GLib.timeout_add(120, self.refresh_once)

    def activate_music_control(self):
        control = MUSIC_CONTROLS[self.music_selected]
        if control["key"] == "repeat":
            current = loop_state()
            if current == "None":
                command = ["playerctl", "-p", "spotify", "loop", "Playlist"]
            elif current == "Playlist":
                command = ["playerctl", "-p", "spotify", "loop", "Track"]
            else:
                command = ["playerctl", "-p", "spotify", "loop", "None"]
        else:
            command = control["command"]
        subprocess.Popen(command)
        GLib.timeout_add(250, self.update_now_playing_once)
        GLib.timeout_add(250, self.refresh_once)

    def update_now_playing_once(self):
        self.update_now_playing()
        return False

    def refresh_once(self):
        self.refresh()
        return False

    def update_now_playing_timer(self):
        self.update_now_playing()
        return True

    def update_now_playing(self):
        track = current_track()
        if not track:
            self.track_title.set_text("Nothing playing")
            self.track_artist.set_text("Spotify")
            self.elapsed_label.set_text("0:00")
            self.remaining_label.set_text("-0:00")
            self.progress.set_fraction(0)
            self.art.clear()
            return

        self.track_title.set_text(track["title"] or "Unknown track")
        self.track_artist.set_text(track["artist"] or "Unknown artist")
        if track["length"] > 0:
            fraction = min(1.0, track["position"] / track["length"])
            remaining = max(0.0, track["length"] - track["position"])
            self.progress.set_fraction(fraction)
            self.elapsed_label.set_text(format_time(track["position"]))
            self.remaining_label.set_text(f"-{format_time(remaining)}")
        else:
            self.progress.set_fraction(0)
            self.elapsed_label.set_text("0:00")
            self.remaining_label.set_text("-0:00")

        art_path = cached_art_path(track["art_url"])
        if not art_path:
            self.art.clear()
            return

        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                art_path, ART_SIZE, ART_SIZE, True
            )
            self.art.set_from_pixbuf(pixbuf)
        except Exception:
            self.art.clear()

    def on_key_press(self, _, event):
        key = Gdk.keyval_name(event.keyval)
        if key in ("Up", "KP_Up"):
            self.move(-1)
        elif key in ("Down", "KP_Down"):
            self.move(1)
        elif key in ("Left", "KP_Left"):
            self.move_horizontal(-1)
        elif key in ("Right", "KP_Right"):
            self.move_horizontal(1)
        elif key in ("Return", "KP_Enter", "space"):
            self.activate()
        elif key in ("Escape", "BackSpace"):
            self.go_back()

    def go_back(self):
        if self.view != "main":
            self.view = "main"
            self.selected = 0
            self.rebuild_rows()
        else:
            Gtk.main_quit()

    def poll_gamepad(self):
        if self.gamepad_event is not None:
            return self.poll_grabbed_gamepad()

        self.try_open_gamepad()
        if self.gamepad is None:
            return True

        try:
            while True:
                ready, _, _ = select.select([self.gamepad], [], [], 0)
                if not ready:
                    break

                data = self.gamepad.read(8)
                if len(data) != 8:
                    self.gamepad.close()
                    self.gamepad = None
                    break

                _, value, event_type, number = struct.unpack("IhBB", data)
                if event_type & 0x80:
                    continue
                if event_type & 0x02:
                    if number in (DPAD_Y, LEFT_STICK_Y):
                        if value < -18000:
                            self.move(-1)
                        elif value > 18000:
                            self.move(1)
                    elif number == DPAD_X:
                        if value < -18000:
                            self.move_horizontal(-1)
                        elif value > 18000:
                            self.move_horizontal(1)
                elif event_type & 0x01 and value == 1:
                    if number == A_BUTTON:
                        self.activate()
                    elif number in (B_BUTTON, HOME_BUTTON):
                        self.go_back()
        except OSError:
            self.gamepad = None

        return True

    def poll_grabbed_gamepad(self):
        try:
            while True:
                ready, _, _ = select.select([self.gamepad_event], [], [], 0)
                if not ready:
                    break

                data = self.gamepad_event.read(24)
                if len(data) != 24:
                    break

                _, _, event_type, code, value = struct.unpack("llHHi", data)
                if event_type == EV_ABS:
                    if code in (ABS_HAT0Y,):
                        if value == 1:
                            self.move(1)
                        elif value == -1:
                            self.move(-1)
                    elif code == ABS_HAT0X:
                        if value == 1:
                            self.move_horizontal(1)
                        elif value == -1:
                            self.move_horizontal(-1)
                    elif code == ABS_Y:
                        if value > ANALOG_CENTER + ANALOG_DEADZONE:
                            self.move(1)
                        elif value < ANALOG_CENTER - ANALOG_DEADZONE:
                            self.move(-1)
                    elif code == ABS_X:
                        if value > ANALOG_CENTER + ANALOG_DEADZONE:
                            self.move_horizontal(1)
                        elif value < ANALOG_CENTER - ANALOG_DEADZONE:
                            self.move_horizontal(-1)
                elif event_type == EV_KEY and value == 1:
                    if code == BTN_SOUTH:
                        self.activate()
                    elif code in (BTN_EAST, BTN_MODE):
                        self.go_back()
        except OSError:
            Gtk.main_quit()

        return True


def main():
    lock_file = open(LOCK_PATH, "w")
    try:
        fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0

    grabbed_gamepad = grab_gamepad()
    window = GameMenu(grabbed_gamepad)
    try:
        Gtk.main()
    finally:
        release_gamepad(grabbed_gamepad)
        window.destroy()
    return 0


if __name__ == "__main__":
    sys.exit(main())
